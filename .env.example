MYSQL_USER=cognivault
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
COGNIVAULT_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COGNIVAULT_BOOTSTRAP_ADMIN_ENABLED=true
COGNIVAULT_BOOTSTRAP_ADMIN_USERNAME=admin.local
COGNIVAULT_BOOTSTRAP_ADMIN_EMAIL=admin.local@example.test
COGNIVAULT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-12-character-password
COGNIVAULT_BOOTSTRAP_ADMIN_NAME=Local Administrator
OLLAMA_MODEL=llama3.2:3b
# Ollama runs natively on the host by default; the ML service container reaches
# it through host.docker.internal. Only point this at http://ollama:11434 when
# running the optional containerized Ollama service (Compose profile "ollama")
# on a host with enough RAM. Pull the model on the host first: ollama pull llama3.2:3b
OLLAMA_URL=http://host.docker.internal:11434
# Per-request Ollama generation timeout; keep below the backend's 240s RAG budget.
OLLAMA_TIMEOUT_SECONDS=120
COGNIVAULT_ML_API_KEY=replace-with-a-separate-random-internal-service-key